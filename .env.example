DISCORD_TOKEN=your_discord_bot_token
ANTHROPIC_API_KEY=your_anthropic_api_key
YELP_API_KEY=your_yelp_fusion_api_key
DATABASE_PATH=./data/receipts.db
CLAUDE_MODEL=sonnet
DAILY_SPEND_LIMIT_USD=0.10

# Optional: enable "Pay with Venmo" buttons on receipt summaries (default: false).
# Only the receipt poster's Venmo handle is used; other participants get a button to pay the poster.
VENMO_ENABLED=false

# Optional: exchange-rate service for foreign-currency receipts.
# Defaults to frankfurter.app (free, no key). Set EXCHANGE_RATE_API_URL to use
# a different provider; use {from}, {to}, and {apikey} placeholders if needed.
# EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/{from}
# EXCHANGE_RATE_API_KEY=your_api_key